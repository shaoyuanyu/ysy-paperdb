# paperdb local development environment.
# Copy to .env and replace secrets. Never commit .env.

PAPERDB_ENV=dev

# PostgreSQL 17 (local Podman container or compose service)
PAPERDB_DATABASE_URL=postgresql+asyncpg://paperdb:paperdb_dev_password@127.0.0.1:5432/paperdb

# Service token: Next.js server -> paperdb. Generate with:
#   python -c 'import secrets; print("pdb_svc_" + secrets.token_hex(24))'
PAPERDB_SERVICE_TOKEN=pdb_svc_dev0123456789abcdef0123456789abcdef

# Pepper for hashing personal/export tokens. Rotating it invalidates all personal tokens.
PAPERDB_TOKEN_PEPPER=dev-pepper-change-me-0123456789abcdef

PAPERDB_STORAGE_BACKEND=local
PAPERDB_STORAGE_ROOT=./data/files
PAPERDB_MAX_UPLOAD_MB=200

# Comma-separated browser origins; empty = CORS disabled (server-to-server only).
PAPERDB_CORS_ORIGINS=

# Metadata sources. No S2 key for now -> 1 rps.
OPENALEX_MAILTO=me
CROSSREF_MAILTO=me
ARXIV_USER_AGENT=paperdb/0.1 (mailto:me)
S2_API_KEY=

# compose.yml database password (keep in sync with PAPERDB_DATABASE_URL)
POSTGRES_PASSWORD=paperdb_dev_password
